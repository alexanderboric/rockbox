{
    "name": "Rockbox STM32U5 Dev",
    "image": "yourusername/rockbox-stm32-ready:latest", 
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/rockbox/rockbox,type=bind",
    "workspaceFolder": "/home/rockbox/rockbox",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools"
            ]
        }
    },
    "remoteUser": "root"
}