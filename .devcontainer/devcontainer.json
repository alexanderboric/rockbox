{
  "name": "Rockbox Dev",
  "image": "ghcr.io/alexanderboric/rockbox:latest",
  "remoteUser": "rockbox",
  "remoteEnv": {
    "PATH": "/usr/local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "anthropic.claude-vscode"
      ]
    }
  }
}